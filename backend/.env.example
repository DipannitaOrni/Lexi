# Gemma via the hosted Gemini API (Google AI Studio) — cloud, API-key based.
# Get a key at https://aistudio.google.com/apikey
GEMMA_API_KEY=your_api_key_here
GEMMA_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMMA_CHAT_MODEL=gemma-4-31b-it
GEMMA_ASR_MODEL=gemma-4-12b-it

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# App configuration
MAX_FILE_SIZE_MB=20
RATE_LIMIT_PER_MINUTE=30
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# Chunking / context budget (in estimated tokens)
LLM_CONTEXT_WINDOW=16000
PROMPT_OVERHEAD_TOKENS=500
RESPONSE_RESERVE_TOKENS=1200

# Storage
DATABASE_PATH=./lexi.db
