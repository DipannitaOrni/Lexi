# Gemma 4 API configuration
GEMMA_API_KEY=your_api_key_here
GEMMA_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMMA_MODEL_NAME=gemma-4
GEMMA_TIMEOUT_SECONDS=30
GEMMA_MAX_RETRIES=3

# App configuration
MAX_FILE_SIZE_MB=20
RATE_LIMIT_PER_MINUTE=30
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# Chunking / context budget (in estimated tokens)
GEMMA_CONTEXT_WINDOW=8000
PROMPT_OVERHEAD_TOKENS=500
RESPONSE_RESERVE_TOKENS=1200
